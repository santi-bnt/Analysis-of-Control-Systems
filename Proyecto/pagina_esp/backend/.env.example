# Backend Configuration
PORT=8000
HOST=0.0.0.0

# MQTT Broker Settings
# Use the private hostname assigned to your EMQX Cloud Serverless deployment.
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=true
MQTT_KEEPALIVE=60
CONTROL_API_TOKEN=

# Control & Safety Limits
MIN_POSITION_DEG=-180.0
MAX_POSITION_DEG=180.0

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
