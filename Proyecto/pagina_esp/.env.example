# ==============================================================================
# Public deployment: copy this file to .env on the cloud server.
# NEVER commit your actual .env file or real credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain pointing to the public server (A/AAAA DNS record)
# ------------------------------------------------------------------------------
SITE_DOMAIN=

# Backend Service Configuration (FastAPI)
PORT=8000
HOST=0.0.0.0

# MQTT Broker (e.g., EMQX Cloud, HiveMQ Cloud, or AWS IoT Core)
# Standard TLS Port is 8883 (or 1883 for non-TLS local development)
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=true
MQTT_KEEPALIVE=60
CONTROL_API_TOKEN=

# Position safety boundaries (degrees)
MIN_POSITION_DEG=-180.0
MAX_POSITION_DEG=180.0

# The reverse proxy sets CORS_ORIGINS to https://SITE_DOMAIN.
# The dashboard uses the same domain for HTTPS and WSS.
# ESP32 secrets belong in the ignored ../ESP32/include/Secrets.h.
