# Analysis of Control Systems ignore rules: environment variables, passwords, and sensitive credentials.
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/Secrets.h
**/secrets.h
**/*secrets*.json
**/*secret*.yaml
**/*secret*.yml

# ------------------------------------------------------------------------------
# 2. TLS / HTTPS certificates and private keys
# ------------------------------------------------------------------------------
**/.cert/
**/*.pem
**/*.key
**/*.crt
**/*.pfx
**/*.p12

# ------------------------------------------------------------------------------
# 3. PlatformIO and microcontroller binaries (ESP32)
# ------------------------------------------------------------------------------
**/.pio/
**/.pioenvs/
**/.piolibdeps/
**/*.elf
**/*.bin
**/*.hex

# Node.js/frontend dependencies and build artifacts.
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
!Proyecto/ESP32/Diagrama_conexiones/dist/
**/*-debug.log*
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ------------------------------------------------------------------------------
# 5. Python (virtual environments, bytecode, and tests)
# ------------------------------------------------------------------------------
**/.venv/
**/venv/
**/env/
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/

# ------------------------------------------------------------------------------
# 6. MATLAB & Simulink (backups and autosave)
# ------------------------------------------------------------------------------
*.asv
*.autosave
*.mat.lock
**/*.slxc
**/*.slx.r*
**/slprj/
Matlab/tmp/

